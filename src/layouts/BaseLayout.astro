---
import SEO from '../components/SEO.astro';
import { siteConfig } from '../../site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishDate?: string;
  author?: string;
}

const props = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <SEO {...props} />

  <!-- Google Analytics 4 -->
  {siteConfig.analytics.ga4 && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.analytics.ga4}`}></script>
      <script define:vars={{ ga4Id: siteConfig.analytics.ga4 }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', ga4Id);
      </script>
    </>
  )}

  <!-- Google AdSense -->
  {siteConfig.adsense.enabled && (
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsense.client}`}
      crossorigin="anonymous"
    ></script>
  )}
</head>
<body class="min-h-screen flex flex-col">

  <!-- Navigation -->
  <nav class="bg-dark text-white sticky top-0 z-50 shadow-lg">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-center justify-between h-16">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 font-display text-xl font-bold">
          <span class="text-primary text-2xl">✝</span>
          <span class="text-primary">Bible</span><span class="text-white">Grace</span>
        </a>

        <!-- Desktop Nav -->
        <div class="hidden md:flex items-center gap-6">
          <a href="/" class="text-gray-300 hover:text-primary transition-colors text-sm font-medium">Home</a>
          <a href="/tools/daily-verse" class="text-gray-300 hover:text-primary transition-colors text-sm font-medium">Daily Verse</a>
          <a href="/tools" class="text-gray-300 hover:text-primary transition-colors text-sm font-medium">Bible Tools</a>

          <!-- Categories Dropdown -->
          <div class="relative group">
            <button class="text-gray-300 hover:text-primary transition-colors text-sm font-medium flex items-center gap-1">
              Categories
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="absolute top-full left-0 mt-1 w-56 bg-white rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              {siteConfig.categories.map(cat => (
                <a href={`/category/${cat.slug}`} class="flex items-center gap-2 px-4 py-2.5 text-sm text-gray-700 hover:bg-amber-50 hover:text-amber-700 transition-colors first:rounded-t-lg last:rounded-b-lg">
                  <span>{cat.emoji}</span>
                  <span>{cat.name}</span>
                </a>
              ))}
            </div>
          </div>

          <a href="/about" class="text-gray-300 hover:text-primary transition-colors text-sm font-medium">About</a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden text-gray-300 hover:text-primary" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden md:hidden pb-4">
        <a href="/" class="block py-2 text-gray-300 hover:text-primary transition-colors">Home</a>
        <a href="/tools/daily-verse" class="block py-2 text-gray-300 hover:text-primary transition-colors">Daily Verse</a>
        <a href="/tools" class="block py-2 text-gray-300 hover:text-primary transition-colors">Bible Tools</a>
        <p class="text-xs text-gray-500 uppercase tracking-wider mt-3 mb-1">Categories</p>
        {siteConfig.categories.map(cat => (
          <a href={`/category/${cat.slug}`} class="block py-2 pl-3 text-gray-300 hover:text-primary transition-colors">
            {cat.emoji} {cat.name}
          </a>
        ))}
        <a href="/about" class="block py-2 text-gray-300 hover:text-primary transition-colors mt-2">About</a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="flex-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-dark text-gray-400 mt-16">
    <div class="max-w-6xl mx-auto px-4 py-12">
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Brand -->
        <div>
          <a href="/" class="font-display text-xl font-bold">
            <span class="text-primary">Bible</span><span class="text-white">Grace</span>
          </a>
          <p class="mt-3 text-sm leading-relaxed">
            Daily Bible verses, devotionals, and free faith tools to help you grow in your walk with God.
          </p>
        </div>

        <!-- Quick Links -->
        <div>
          <h3 class="text-white font-semibold mb-3">Explore</h3>
          <div class="space-y-2">
            {siteConfig.categories.slice(0, 5).map(cat => (
              <a href={`/category/${cat.slug}`} class="block text-sm hover:text-primary transition-colors">
                {cat.emoji} {cat.name}
              </a>
            ))}
          </div>
        </div>

        <!-- Tools -->
        <div>
          <h3 class="text-white font-semibold mb-3">Faith Tools</h3>
          <div class="space-y-2">
            {siteConfig.tools.slice(0, 5).map(tool => (
              <a href={`/tools/${tool.slug}`} class="block text-sm hover:text-primary transition-colors">
                {tool.emoji} {tool.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="border-t border-gray-700 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm">&copy; {new Date().getFullYear()} BibleGrace. All rights reserved.</p>
        <div class="flex gap-4">
          {siteConfig.footerLinks.map(link => (
            <a href={link.href} class="text-sm hover:text-primary transition-colors">{link.name}</a>
          ))}
        </div>
      </div>
    </div>
  </footer>

  <!-- Mobile Menu Script -->
  <script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
    });
  </script>

</body>
</html>
