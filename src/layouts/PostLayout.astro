---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorCard from '../components/AuthorCard.astro';
import FAQ from '../components/FAQ.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { siteConfig } from '../../site.config';

const { frontmatter, headings } = Astro.props;
const { title, description, date, author, category, image, tags } = frontmatter;
const categoryInfo = siteConfig.categories.find(c => c.slug === category);
const authorInfo = siteConfig.authors.find(a => a.id === author);
---

<BaseLayout title={title} description={description} image={image} article={true} publishDate={date}>

  <!-- Article Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": image,
    "datePublished": date,
    "author": {
      "@type": "Person",
      "name": authorInfo?.name || 'BibleGrace Team'
    },
    "publisher": {
      "@type": "Organization",
      "name": "BibleGrace",
      "url": siteConfig.url
    }
  })} />
{/* FAQ Schema */}
  {frontmatter.faq && frontmatter.faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": frontmatter.faq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
  )}
  <article class="max-w-4xl mx-auto px-4 py-8">
    <!-- Breadcrumb -->
    <Breadcrumb items={[
      { name: 'Home', href: '/' },
      ...(categoryInfo ? [{ name: categoryInfo.name, href: `/category/${category}` }] : []),
      { name: title, href: '#' }
    ]} />

    <!-- Article Header -->
    <header class="mb-8 mt-4">
      {categoryInfo && (
        <a href={`/category/${category}`} class="category-tag mb-3 inline-block">
          {categoryInfo.emoji} {categoryInfo.name}
        </a>
      )}
      <h1 class="text-3xl md:text-4xl font-display font-bold text-dark leading-tight mt-2">
        {title}
      </h1>
      <div class="flex items-center gap-4 mt-4 text-text-secondary text-sm">
        {authorInfo && <span>By {authorInfo.name}</span>}
        {date && <time datetime={date}>{new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>}
      </div>
    </header>

    {/* Hero Image */}
    {image && (
      <img src={image} alt={title} class="w-full rounded-xl mb-8 shadow-md" loading="lazy" />
    )}

    <!-- Table of Contents -->
    {headings && headings.length > 2 && (
      <TableOfContents headings={headings} />
    )}

    <!-- Article Content -->
    <div class="prose prose-lg max-w-none prose-headings:font-display prose-headings:text-dark prose-a:text-primary hover:prose-a:text-primary-dark">
      <slot />
    </div>

    <!-- Author Card -->
    {authorInfo && <AuthorCard author={authorInfo} />}
{/* FAQ Section */}
    {frontmatter.faq && frontmatter.faq.length > 0 && (
      <FAQ items={frontmatter.faq} />
    )}

    {/* Related Posts */}
    <RelatedPosts category={category} currentSlug={Astro.params.slug} />
    <!-- Share Buttons -->
    <div class="mt-8 pt-6 border-t border-gray-200">
      <p class="text-text-secondary font-medium mb-3">Share this article:</p>
      <div class="flex gap-3">
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${siteConfig.url}/posts/${Astro.params.slug}`} target="_blank" rel="noopener" class="btn-secondary text-sm py-2 px-4">
          Facebook
        </a>
        <a href={`https://twitter.com/intent/tweet?url=${siteConfig.url}/posts/${Astro.params.slug}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" class="btn-secondary text-sm py-2 px-4">
          X / Twitter
        </a>
        <a href={`https://pinterest.com/pin/create/button/?url=${siteConfig.url}/posts/${Astro.params.slug}&description=${encodeURIComponent(title)}`} target="_blank" rel="noopener" class="btn-secondary text-sm py-2 px-4">
          Pinterest
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
