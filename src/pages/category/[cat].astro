---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { siteConfig } from '../../../site.config';

export function getStaticPaths() {
  return siteConfig.categories.map(cat => ({
    params: { cat: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;

// Get posts for this category
const allPosts = await Astro.glob('../posts/*.md');
const posts = allPosts
  .filter(p => p.frontmatter.category === category.slug && p.frontmatter.draft !== true)
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<BaseLayout
  title={category.name}
  description={category.description}
>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { name: 'Home', href: '/' },
      { name: category.name, href: `/category/${category.slug}` }
    ]} />

    <div class="text-center mt-6 mb-12">
      <p class="text-4xl mb-3">{category.emoji}</p>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-dark">
        {category.name}
      </h1>
      <p class="text-text-secondary mt-3">{category.description}</p>
    </div>

    {posts.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map(post => (
          <a href={post.url} class="card group">
            {post.frontmatter.image && (
              <img src={post.frontmatter.image} alt={post.frontmatter.title} class="w-full h-48 object-cover" loading="lazy" />
            )}
            <div class="p-5">
              <h3 class="font-display font-semibold text-dark group-hover:text-primary transition-colors">
                {post.frontmatter.title}
              </h3>
              <p class="text-text-secondary text-sm mt-2 line-clamp-2">
                {post.frontmatter.description}
              </p>
              <p class="text-xs text-text-secondary mt-3">
                {new Date(post.frontmatter.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-16 rounded-xl" style="background-color: #FAF0D7;">
        <p class="text-5xl mb-4">{category.emoji}</p>
        <p class="text-lg font-medium text-dark">Articles coming soon!</p>
        <p class="text-text-secondary mt-2">Check back soon for new content in {category.name}.</p>
        <a href="/" class="btn-primary mt-6 inline-block">← Back to Home</a>
      </div>
    )}
  </div>
</BaseLayout>
