---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<BaseLayout title="Contact Us" description="Get in touch with the BibleGrace team. We'd love to hear from you.">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { name: 'Home', href: '/' },
      { name: 'Contact', href: '/contact' }
    ]} />

    <div class="text-center mt-6 mb-12">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-dark">Contact Us</h1>
      <p class="text-text-secondary mt-3">Have a question, suggestion, or prayer request? We'd love to hear from you.</p>
    </div>

    <div class="max-w-xl mx-auto bg-white rounded-xl shadow-md p-8">
      <div class="space-y-6">
        <div class="text-center p-6 rounded-xl" style="background-color: #FAF0D7;">
          <p class="text-3xl mb-3">📧</p>
          <p class="font-semibold text-dark">Email Us</p>
          <p class="text-text-secondary mt-2">contact@freshblogs.cc</p>
        </div>

        <div class="text-center p-6 rounded-xl" style="background-color: #FAF0D7;">
          <p class="text-3xl mb-3">💡</p>
          <p class="font-semibold text-dark">Suggest a Topic</p>
          <p class="text-text-secondary mt-2">Have a Bible question or topic you'd like us to write about? Let us know!</p>
        </div>

        <div class="text-center p-6 rounded-xl" style="background-color: #FAF0D7;">
          <p class="text-3xl mb-3">🙏</p>
          <p class="font-semibold text-dark">Prayer Requests</p>
          <p class="text-text-secondary mt-2">We believe in the power of prayer. Share your prayer request with us.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
