---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VerseFinder from '../../components/tools/VerseFinder.jsx';
---

<BaseLayout
  title="Bible Verse Finder — Search by Topic"
  description="Find Bible verses by topic — love, strength, anxiety, peace, healing, and more. Search the KJV Bible and discover scriptures that speak to your heart."
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { name: 'Home', href: '/' },
      { name: 'Faith Tools', href: '/tools' },
      { name: 'Verse Finder', href: '/tools/verse-finder' }
    ]} />

    <div class="text-center mt-6 mb-10">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-dark">
        🔍 Bible Verse Finder
      </h1>
      <p class="text-text-secondary mt-3">
        Search Bible verses by topic, keyword, or book. Find the perfect scripture for any moment.
      </p>
    </div>

    <VerseFinder client:load />

    <div class="mt-16 max-w-2xl mx-auto">
      <h2 class="text-xl font-display font-bold text-dark mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="bg-white rounded-xl p-5 shadow-sm">
          <summary class="font-semibold cursor-pointer text-dark">How many verses are in this tool?</summary>
          <p class="mt-3 text-text-secondary text-sm">Our database includes 100+ carefully selected verses from across the Bible, organized into 25+ topics. We regularly add new verses.</p>
        </details>
        <details class="bg-white rounded-xl p-5 shadow-sm">
          <summary class="font-semibold cursor-pointer text-dark">What topics can I search for?</summary>
          <p class="mt-3 text-text-secondary text-sm">You can search by topic like love, strength, anxiety, peace, healing, forgiveness, hope, courage, and many more. You can also search by book name or keyword.</p>
        </details>
      </div>
    </div>
  </div>
</BaseLayout>
