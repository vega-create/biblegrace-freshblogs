---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
---

<BaseLayout title="Reading Plan Generator" description="Create a personalized Bible reading plan">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { name: "Home", href: "/" },
      { name: "Faith Tools", href: "/tools" },
      { name: "Reading Plan Generator", href: "/tools/reading-plan" }
    ]} />

    <div class="text-center mt-6 mb-10">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-dark">
        📅 Reading Plan Generator
      </h1>
      <p class="text-text-secondary mt-3">Create a personalized Bible reading plan</p>
    </div>

    <div class="text-center py-16 rounded-2xl" style="background-color: #FAF0D7;">
      <p class="text-6xl mb-4">📅</p>
      <h2 class="text-2xl font-display font-bold text-dark mb-3">Coming Soon!</h2>
      <p class="text-text-secondary max-w-md mx-auto">
        We are building this tool right now. Check back soon, or explore our other faith tools in the meantime.
      </p>
      <a href="/tools" class="btn-primary mt-6 inline-block">Explore Other Tools</a>
    </div>
  </div>
</BaseLayout>
