---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DailyVerse from '../../components/tools/DailyVerse.jsx';
---

<BaseLayout
  title="Daily Bible Verse"
  description="Get your daily Bible verse with reflection and prayer. A new verse from the KJV Bible every day to inspire and encourage your faith."
>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { name: 'Home', href: '/' },
      { name: 'Faith Tools', href: '/tools' },
      { name: 'Daily Verse', href: '/tools/daily-verse' }
    ]} />

    <div class="text-center mt-6 mb-10">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-dark">
        📖 Daily Bible Verse
      </h1>
      <p class="text-text-secondary mt-3">
        Start each day with God's Word. A new verse with reflection every day.
      </p>
    </div>

    <DailyVerse client:load />

    {/* FAQ Schema */}
    <div class="mt-16 max-w-2xl mx-auto">
      <h2 class="text-xl font-display font-bold text-dark mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="bg-white rounded-xl p-5 shadow-sm">
          <summary class="font-semibold cursor-pointer text-dark">When does the daily verse change?</summary>
          <p class="mt-3 text-text-secondary text-sm">The daily verse changes at midnight. Everyone sees the same verse on the same day, making it perfect for group discussion and sharing.</p>
        </details>
        <details class="bg-white rounded-xl p-5 shadow-sm">
          <summary class="font-semibold cursor-pointer text-dark">What Bible version are these verses from?</summary>
          <p class="mt-3 text-text-secondary text-sm">All verses are from the King James Version (KJV), one of the most widely read and beloved English translations of the Bible.</p>
        </details>
        <details class="bg-white rounded-xl p-5 shadow-sm">
          <summary class="font-semibold cursor-pointer text-dark">Can I share the daily verse?</summary>
          <p class="mt-3 text-text-secondary text-sm">Yes! Use the share buttons to post on Facebook, X (Twitter), or copy the verse to share via text message, email, or any other platform.</p>
        </details>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "When does the daily verse change?",
        "acceptedAnswer": { "@type": "Answer", "text": "The daily verse changes at midnight." }
      },
      {
        "@type": "Question",
        "name": "What Bible version are these verses from?",
        "acceptedAnswer": { "@type": "Answer", "text": "All verses are from the King James Version (KJV)." }
      }
    ]
  })} />
</BaseLayout>
