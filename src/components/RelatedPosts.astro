---
const { category, currentSlug } = Astro.props;

const allPosts = await Astro.glob('../pages/posts/*.md');
const related = allPosts
  .filter(p => 
    p.frontmatter.category === category && 
    !p.url?.endsWith(currentSlug) &&
    !p.frontmatter.draft
  )
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3);
---

{related.length > 0 && (
  <section class="mt-10 pt-8 border-t border-gray-200">
    <h2 class="text-2xl font-display font-bold text-dark mb-6">You May Also Like</h2>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {related.map(post => (
        <a href={post.url} class="group block bg-card-bg border border-gray-100 rounded-xl p-5 hover:shadow-md transition-all no-underline">
          <span class="text-xs font-medium text-primary uppercase tracking-wide">
            {post.frontmatter.category?.replace(/-/g, ' ')}
          </span>
          <h3 class="text-base font-display font-bold text-dark mt-2 mb-2 group-hover:text-primary transition-colors line-clamp-2">
            {post.frontmatter.title}
          </h3>
          <p class="text-sm text-text-secondary line-clamp-2">
            {post.frontmatter.description}
          </p>
        </a>
      ))}
    </div>
  </section>
)}
