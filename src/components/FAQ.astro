---
const { items } = Astro.props;
---

{items && items.length > 0 && (
  <section class="mt-12 pt-8 border-t border-gray-200" id="faq">
    <h2 class="text-2xl font-display font-bold text-dark mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {items.map((item, index) => (
        <details class="group bg-cream border border-card rounded-lg overflow-hidden" open={index === 0}>
          <summary class="flex items-center justify-between p-5 cursor-pointer select-none hover:bg-card transition-colors">
            <h3 class="font-semibold text-dark text-base pr-4">{item.q}</h3>
            <svg class="w-5 h-5 text-primary flex-shrink-0 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <div class="px-5 pb-5 text-text-primary leading-relaxed border-t border-card">
            <p class="mt-3">{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </section>
)}
