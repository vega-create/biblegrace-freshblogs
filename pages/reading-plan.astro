---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ReadingPlan from "../../components/tools/ReadingPlan.jsx";
---

<BaseLayout title="Bible Reading Plan Generator — Create Your Personal Plan" description="Generate a personalized Bible reading plan. Choose from whole Bible, New Testament, Gospels, Psalms & Proverbs, or Paul's Letters.">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { name: "Home", href: "/" },
      { name: "Faith Tools", href: "/tools" },
      { name: "Reading Plan Generator", href: "/tools/reading-plan" }
    ]} />

    <div class="text-center mt-6 mb-10">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-dark">
        📅 Reading Plan Generator
      </h1>
      <p class="text-text-secondary mt-3">Create a personalized Bible reading plan that fits your schedule</p>
    </div>

    <ReadingPlan client:load />

    <div class="mt-12 prose prose-amber max-w-none">
      <h2 class="font-display">Why Have a Bible Reading Plan?</h2>
      <p>Reading the Bible consistently is one of the most impactful habits a Christian can develop. A structured reading plan removes the guesswork and helps you stay on track — whether you want to read the entire Bible in a year or focus on specific books.</p>
      <h3>Tips for Staying Consistent</h3>
      <ul>
        <li><strong>Start small:</strong> If you're new to Bible reading, begin with the Gospels or Psalms & Proverbs.</li>
        <li><strong>Same time daily:</strong> Attach your reading to an existing habit, like morning coffee.</li>
        <li><strong>Don't give up:</strong> If you miss a day, just pick up where you left off — no guilt!</li>
        <li><strong>Take notes:</strong> Write down one thing that stands out from each day's reading.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
