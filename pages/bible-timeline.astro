---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import BibleTimeline from "../../components/tools/BibleTimeline.jsx";
---

<BaseLayout title="Interactive Bible Timeline — Explore Biblical History" description="Explore 4,000+ years of Biblical history on an interactive timeline. From Creation to the Early Church, discover key events, people, and scripture references.">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { name: "Home", href: "/" },
      { name: "Faith Tools", href: "/tools" },
      { name: "Bible Timeline", href: "/tools/bible-timeline" }
    ]} />

    <div class="text-center mt-6 mb-10">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-dark">
        ⏳ Bible Timeline
      </h1>
      <p class="text-text-secondary mt-3">Explore Biblical history visually — from Creation to the Early Church</p>
    </div>

    <BibleTimeline client:load />

    <div class="mt-12 prose prose-amber max-w-none">
      <h2 class="font-display">Understanding the Bible Timeline</h2>
      <p>The Bible spans thousands of years of human history, from the creation of the world to the establishment of the early Christian church. This interactive timeline helps you see how key events, people, and prophecies connect across the biblical narrative.</p>
      <h3>How to Use This Timeline</h3>
      <ul>
        <li><strong>Select an era:</strong> Click on any era button to explore that period of Biblical history.</li>
        <li><strong>Expand events:</strong> Click on any event card to see more details and scripture references.</li>
        <li><strong>Read the references:</strong> Look up the scripture passages to dive deeper into each event.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
