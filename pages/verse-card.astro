---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import VerseCardMaker from "../../components/tools/VerseCardMaker.jsx";
---

<BaseLayout title="Verse Card Maker — Create Beautiful Bible Verse Images" description="Create beautiful, shareable Bible verse cards with custom themes, fonts, and colors. Download or share your verse images for free.">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <Breadcrumb items={[
      { name: "Home", href: "/" },
      { name: "Faith Tools", href: "/tools" },
      { name: "Verse Card Maker", href: "/tools/verse-card" }
    ]} />

    <div class="text-center mt-6 mb-10">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-dark">
        🎨 Verse Card Maker
      </h1>
      <p class="text-text-secondary mt-3">Create beautiful Bible verse cards to download and share</p>
    </div>

    <VerseCardMaker client:load />

    <div class="mt-12 prose prose-amber max-w-none">
      <h2 class="font-display">How to Use the Verse Card Maker</h2>
      <p>Create stunning Bible verse images to share on social media, use as phone wallpapers, or send to friends and family. Simply type or select a verse, choose your theme and font, then download your custom verse card.</p>
      <h3>Tips for Great Verse Cards</h3>
      <ul>
        <li><strong>Keep it short:</strong> Shorter verses look best on cards. Try Psalm 46:10 or Philippians 4:13.</li>
        <li><strong>Match the mood:</strong> Use warm themes for encouraging verses, cool themes for peaceful ones.</li>
        <li><strong>Share freely:</strong> All cards include the verse reference so recipients can look it up.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
